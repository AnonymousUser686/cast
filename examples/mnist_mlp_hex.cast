            w1t[17][3][0] = 16; w1t[17][3][1] = 4294967294; w1t[17][3][2] = 4294967259; w1t[17][3][3] = 4294967295; w1t[17][3][4] = 4294967274;
            w1t[17][4][0] = 4294967279; w1t[17][4][1] = 32; w1t[17][4][2] = 4294967246; w1t[17][4][3] = 4294967258; w1t[17][4][4] = 15;
            w1t[18][0][0] = 4294967282; w1t[18][0][1] = 46; w1t[18][0][2] = 24; w1t[18][0][3] = 43; w1t[18][0][4] = 35;
            w1t[18][1][0] = 26; w1t[18][1][1] = 45; w1t[18][1][2] = 47; w1t[18][1][3] = 15; w1t[18][1][4] = 4294967281;
            w1t[18][2][0] = 45; w1t[18][2][1] = 26; w1t[18][2][2] = 35; w1t[18][2][3] = 13; w1t[18][2][4] = 4294967246;
            w1t[18][3][0] = 23; w1t[18][3][1] = 27; w1t[18][3][2] = 77; w1t[18][3][3] = 11; w1t[18][3][4] = 4294967267;
            w1t[18][4][0] = 44; w1t[18][4][1] = 25; w1t[18][4][2] = 57; w1t[18][4][3] = 4294967270; w1t[18][4][4] = 28;
            w1t[19][0][0] = 40; w1t[19][0][1] = 4294967247; w1t[19][0][2] = 4294967272; w1t[19][0][3] = 61; w1t[19][0][4] = 8;
            w1t[19][1][0] = 14; w1t[19][1][1] = 4294967272; w1t[19][1][2] = 4294967259; w1t[19][1][3] = 25; w1t[19][1][4] = 4294967269;
            w1t[19][2][0] = 4294967273; w1t[19][2][1] = 12; w1t[19][2][2] = 16; w1t[19][2][3] = 4294967289; w1t[19][2][4] = 1;
            w1t[19][3][0] = 4294967279; w1t[19][3][1] = 15; w1t[19][3][2] = 10; w1t[19][3][3] = 30; w1t[19][3][4] = 52;
            w1t[19][4][0] = 19; w1t[19][4][1] = 11; w1t[19][4][2] = 4294967261; w1t[19][4][3] = 18; w1t[19][4][4] = 85;

            // Layer 1 bias, in accumulator units.
            b1t[0][0] = 4294964511; b1t[0][1] = 10871; b1t[0][2] = 6381; b1t[0][3] = 4558; b1t[0][4] = 4295;
            b1t[1][0] = 4294967163; b1t[1][1] = 5179; b1t[1][2] = 6945; b1t[1][3] = 4294965405; b1t[1][4] = 5317;
            b1t[2][0] = 453; b1t[2][1] = 4294966813; b1t[2][2] = 7807; b1t[2][3] = 792; b1t[2][4] = 672;
            b1t[3][0] = 6508; b1t[3][1] = 4294965243; b1t[3][2] = 5092; b1t[3][3] = 3301; b1t[3][4] = 2758;

            // Layer 2 weights: w2t[k-tile * 2 + j-tile][unit][class].
            w2t[0][0][0] = 1; w2t[0][0][1] = 4294967289; w2t[0][0][2] = 4294967284; w2t[0][0][3] = 4294967292; w2t[0][0][4] = 4294967285;
            w2t[0][1][0] = 4294967203; w2t[0][1][1] = 29; w2t[0][1][2] = 4294967186; w2t[0][1][3] = 4294967243; w2t[0][1][4] = 41;
            w2t[0][2][0] = 31; w2t[0][2][1] = 4294967230; w2t[0][2][2] = 3; w2t[0][2][3] = 4294967248; w2t[0][2][4] = 4294967287;
            w2t[0][3][0] = 4294967229; w2t[0][3][1] = 4294967226; w2t[0][3][2] = 55; w2t[0][3][3] = 4294967226; w2t[0][3][4] = 59;
            w2t[0][4][0] = 4294967249; w2t[0][4][1] = 4294967233; w2t[0][4][2] = 4294967240; w2t[0][4][3] = 37; w2t[0][4][4] = 39;
            w2t[1][0][0] = 4294967292; w2t[1][0][1] = 4294967288; w2t[1][0][2] = 4294967291; w2t[1][0][3] = 8; w2t[1][0][4] = 4294967290;
            w2t[1][1][0] = 65; w2t[1][1][1] = 4294967266; w2t[1][1][2] = 4; w2t[1][1][3] = 4294967282; w2t[1][1][4] = 38;
            w2t[1][2][0] = 33; w2t[1][2][1] = 51; w2t[1][2][2] = 4294967280; w2t[1][2][3] = 4294967281; w2t[1][2][4] = 4294967248;
            w2t[1][3][0] = 4294967257; w2t[1][3][1] = 39; w2t[1][3][2] = 19; w2t[1][3][3] = 4294967262; w2t[1][3][4] = 4294967287;
            w2t[1][4][0] = 4294967272; w2t[1][4][1] = 4294967236; w2t[1][4][2] = 59; w2t[1][4][3] = 4294967288; w2t[1][4][4] = 4294967293;
            w2t[2][0][0] = 4294967287; w2t[2][0][1] = 39; w2t[2][0][2] = 64; w2t[2][0][3] = 4294967240; w2t[2][0][4] = 4294967243;
            w2t[2][1][0] = 58; w2t[2][1][1] = 4294967230; w2t[2][1][2] = 4294967279; w2t[2][1][3] = 4294967279; w2t[2][1][4] = 4294967248;
            w2t[2][2][0] = 36; w2t[2][2][1] = 16; w2t[2][2][2] = 4294967239; w2t[2][2][3] = 4294967267; w2t[2][2][4] = 4294967257;
            w2t[2][3][0] = 41; w2t[2][3][1] = 4294967222; w2t[2][3][2] = 25; w2t[2][3][3] = 47; w2t[2][3][4] = 4294967186;
            w2t[2][4][0] = 4294967290; w2t[2][4][1] = 10; w2t[2][4][2] = 4294967284; w2t[2][4][3] = 4294967267; w2t[2][4][4] = 30;
            w2t[3][0][0] = 4294967181; w2t[3][0][1] = 81; w2t[3][0][2] = 76; w2t[3][0][3] = 28; w2t[3][0][4] = 4294967192;
            w2t[3][1][0] = 57; w2t[3][1][1] = 4294967254; w2t[3][1][2] = 4294967278; w2t[3][1][3] = 4294967289; w2t[3][1][4] = 4294967284;
            w2t[3][2][0] = 4294967232; w2t[3][2][1] = 21; w2t[3][2][2] = 54; w2t[3][2][3] = 4294967244; w2t[3][2][4] = 57;
            w2t[3][3][0] = 6; w2t[3][3][1] = 4294967249; w2t[3][3][2] = 28; w2t[3][3][3] = 17; w2t[3][3][4] = 4294967258;
            w2t[3][4][0] = 4294967263; w2t[3][4][1] = 4294967169; w2t[3][4][2] = 55; w2t[3][4][3] = 4294967278; w2t[3][4][4] = 52;
            w2t[4][0][0] = 23; w2t[4][0][1] = 4294967233; w2t[4][0][2] = 22; w2t[4][0][3] = 8; w2t[4][0][4] = 5;
            w2t[4][1][0] = 56; w2t[4][1][1] = 4294967287; w2t[4][1][2] = 39; w2t[4][1][3] = 4294967271; w2t[4][1][4] = 4294967280;
            w2t[4][2][0] = 4294967228; w2t[4][2][1] = 74; w2t[4][2][2] = 5; w2t[4][2][3] = 4294967271; w2t[4][2][4] = 4294967260;
            w2t[4][3][0] = 4294967275; w2t[4][3][1] = 25; w2t[4][3][2] = 4294967255; w2t[4][3][3] = 53; w2t[4][3][4] = 4294967237;
            w2t[4][4][0] = 4294967244; w2t[4][4][1] = 4294967269; w2t[4][4][2] = 49; w2t[4][4][3] = 4294967283; w2t[4][4][4] = 4294967199;
            w2t[5][0][0] = 4; w2t[5][0][1] = 45; w2t[5][0][2] = 4294967224; w2t[5][0][3] = 7; w2t[5][0][4] = 5;
            w2t[5][1][0] = 4294967246; w2t[5][1][1] = 4294967291; w2t[5][1][2] = 4294967268; w2t[5][1][3] = 11; w2t[5][1][4] = 4294967243;
            w2t[5][2][0] = 30; w2t[5][2][1] = 45; w2t[5][2][2] = 4294967226; w2t[5][2][3] = 4294967291; w2t[5][2][4] = 4294967214;
            w2t[5][3][0] = 4294967287; w2t[5][3][1] = 4294967268; w2t[5][3][2] = 4294967269; w2t[5][3][3] = 30; w2t[5][3][4] = 7;
            w2t[5][4][0] = 4294967286; w2t[5][4][1] = 4294967173; w2t[5][4][2] = 57; w2t[5][4][3] = 25; w2t[5][4][4] = 60;
            w2t[6][0][0] = 25; w2t[6][0][1] = 26; w2t[6][0][2] = 41; w2t[6][0][3] = 40; w2t[6][0][4] = 4294967292;
            w2t[6][1][0] = 4294967254; w2t[6][1][1] = 4294967271; w2t[6][1][2] = 4294967238; w2t[6][1][3] = 4294967242; w2t[6][1][4] = 37;
            w2t[6][2][0] = 4294967254; w2t[6][2][1] = 4294967282; w2t[6][2][2] = 4294967231; w2t[6][2][3] = 22; w2t[6][2][4] = 29;
            w2t[6][3][0] = 4294967210; w2t[6][3][1] = 62; w2t[6][3][2] = 25; w2t[6][3][3] = 55; w2t[6][3][4] = 4294967289;
            w2t[6][4][0] = 4294967253; w2t[6][4][1] = 14; w2t[6][4][2] = 40; w2t[6][4][3] = 18; w2t[6][4][4] = 39;
            w2t[7][0][0] = 18; w2t[7][0][1] = 4294967230; w2t[7][0][2] = 56; w2t[7][0][3] = 4294967205; w2t[7][0][4] = 4294967250;
            w2t[7][1][0] = 0; w2t[7][1][1] = 4294967289; w2t[7][1][2] = 4294967264; w2t[7][1][3] = 70; w2t[7][1][4] = 29;
            w2t[7][2][0] = 31; w2t[7][2][1] = 2; w2t[7][2][2] = 34; w2t[7][2][3] = 4294967237; w2t[7][2][4] = 15;
            w2t[7][3][0] = 5; w2t[7][3][1] = 4294967202; w2t[7][3][2] = 5; w2t[7][3][3] = 4294967285; w2t[7][3][4] = 4294967271;
            w2t[7][4][0] = 4294967282; w2t[7][4][1] = 21; w2t[7][4][2] = 4294967218; w2t[7][4][3] = 5; w2t[7][4][4] = 23;

            // Layer 2 bias.
            b2t[0][0] = 161; b2t[0][1] = 264; b2t[0][2] = 4294967126; b2t[0][3] = 4294967066; b2t[0][4] = 4294966951;
            b2t[1][0] = 594; b2t[1][1] = 409; b2t[1][2] = 4294966939; b2t[1][3] = 4294966691; b2t[1][4] = 4294967210;

            // True labels, printed alongside each guess.
            lbl[0] = 7; lbl[1] = 2; lbl[2] = 1; lbl[3] = 0; lbl[4] = 4;

            layer = 1; kt = 0; jt = 0;
            print("MnistMLP: 5 images, 25 pixels -> 20 hidden -> 10 classes");
            goto stage;
        }

        // Stage one 5x5 operand pair and clear the array. The very first
        // pair is placed directly on the hexagon's apex PE(4,4); every later
        // pair is injected by `step` on the cycle before it is needed.
        stage: {
            if (layer == 1) {
                for (var int i = 0; i < 5; i++) {
                    for (var int k = 0; k < 5; k++) {
                        opA[i][k] = xt[kt][i][k];
                    }
                }
                for (var int k = 0; k < 5; k++) {
                    for (var int j = 0; j < 5; j++) {
                        opB[k][j] = w1t[kt * 4 + jt][k][j];
                    }
                }
            } else {
                // Layer 2's activations are layer 1's accumulators, already
                // partitioned the same way: j-tiles of hidden units become
                // k-tiles of layer 2 inputs.
                for (var int i = 0; i < 5; i++) {
                    for (var int k = 0; k < 5; k++) {
                        opA[i][k] = acc1[kt][i][k];
                    }
                }
                for (var int k = 0; k < 5; k++) {
                    for (var int j = 0; j < 5; j++) {
                        opB[k][j] = w2t[kt * 2 + jt][k][j];
                    }
                }
            }

            for (var int U = 0; U < 9; U++) {
                for (var int V = 0; V < 9; V++) {
                    ha[U][V] = 0; hb[U][V] = 0; hc[U][V] = 0;
                }
            }
            // Overrides the zero written just above: later writes win.
            if (layer == 1) {
                ha[4][4] = xt[kt][0][0];
                hb[4][4] = w1t[kt * 4 + jt][0][0];
            } else {
                ha[4][4] = acc1[kt][0][0];
                hb[4][4] = w2t[kt * 2 + jt][0][0];
            }
            t = 0;
            goto step;
        }

        // ------------------------------------------------------------------
        // One cycle of the hexagonal (Kung-Leiserson) array.
        //
        // C[i][j] += A[i][k]*B[k][j] has a 5x5x5 iteration space. Project that
        // cube along its (1,1,1) diagonal and schedule iteration (i,j,k) at
        // time t = i+j+k. Each operand then travels along one of three axes
        // 120 degrees apart, one PE per cycle:
        //
        //     PE(U,V) = (i-k+4, j-k+4)        U,V in 0..8
        //
        //     A[i][k] -> +V        B[k][j] -> +U        C[i][j] -> (-1,-1)
        //
        // Nothing is stationary. Unlike the square array in
        // systolic_matmul.cast, where C sits still and only the operands
        // move, here the partial sums stream through as well -- that is what
        // makes the connectivity hexagonal, six neighbours per PE.
        //
        // The live sites form a hexagon inside the 9x9 box (61 of 81);
        // the corners stay zero. Because the projection direction equals the
        // schedule vector, a PE holds a matching (i,j,k) triple only every
        // third cycle. On the other two it passes data through, and the
        // partial sums riding those slots are never captured.
        //
        // The five blocks below are the five wires of one PE, written once
        // and replicated by the unroller.
        // ------------------------------------------------------------------
        step: {
            // 1. Multiply-accumulate. Nothing below has written ha, hb or hc
            //    yet, so every PE reads its start-of-cycle operands and the
            //    whole array acts at once, as the hardware would.
            for (var int U = 0; U < 9; U++) {
                for (var int V = 0; V < 9; V++) {
                    hr[U][V] = hc[U][V] + ha[U][V] * hb[U][V];
                }
            }

            // 2. A advances one PE in +V. Iterate V downwards so each PE
            //    reads its neighbour's pre-shift value.
            for (var int U = 0; U < 9; U++) {
                for (var int V = 8; V > 0; V--) { ha[U][V] = ha[U][V - 1]; }
                ha[U][0] = 0;
            }

            // 3. B advances one PE in +U.
            for (var int V = 0; V < 9; V++) {
                for (var int U = 8; U > 0; U--) { hb[U][V] = hb[U - 1][V]; }
                hb[0][V] = 0;
            }

            // 4. Partial sums advance one PE in (-1,-1), carrying the MAC
            //    just computed. The far edges feed in empty slots.
            for (var int U = 0; U < 8; U++) {
                for (var int V = 0; V < 8; V++) { hc[U][V] = hr[U + 1][V + 1]; }
                hc[U][8] = 0;
            }
            for (var int V = 0; V < 9; V++) { hc[8][V] = 0; }

            // 5. Inject the operands that must be in place next cycle.
            //    A[i][k] enters the hexagon where j == 0, at PE(i+V, V) with
            //    V = 4-k; B[k][j] enters where i == 0, at PE(U, U+j) with
            //    U = 4-k. Both the site and the arrival time are compile-time
            //    constants, so this costs one comparison against t per edge.
            for (var int V = 0; V < 5; V++) {
                for (var int i = 0; i < 5; i++) {
                    if (t + 1 + V == i + 4) { ha[i + V][V] = opA[i][4 - V]; }
                }
            }
            for (var int U = 0; U < 5; U++) {
                for (var int j = 0; j < 5; j++) {
                    if (t + 1 + U == j + 4) { hb[U][U + j] = opB[4 - U][j]; }
                }
            }

            // 6. A fresh zero accumulator enters at PE(i+4, j+4) for the
            //    k == 0 term of C[i][j].
            for (var int i = 0; i < 5; i++) {
                for (var int j = 0; j < 5; j++) {
                    if (t + 1 == i + j) { hc[i + 4][j + 4] = 0; }
                }
            }

            // 7. C[i][j] is finished by its k == 4 term, which lands on
            //    PE(i,j) at t = i+j+4. Catch it as it leaves.
            for (var int i = 0; i < 5; i++) {
                for (var int j = 0; j < 5; j++) {
                    if (t == i + j + 4) { hout[i][j] = hr[i][j]; }
                }
            }

            t++;
            // t reads its start-of-cycle value, so the pass ends after the
            // cycle that captured C[4][4].
            if (t < 12) { goto step; } else { goto accum; }
        }

        // Fold the tile product into the running sum and step the tile
        // indices. One systolic pass covers k-tile `kt` of output block `jt`.
        accum: {
            if (layer == 1) {
                for (var int i = 0; i < 5; i++) {
                    for (var int j = 0; j < 5; j++) { acc1[jt][i][j] += hout[i][j]; }
                }
            } else {
                for (var int i = 0; i < 5; i++) {
                    for (var int j = 0; j < 5; j++) { acc2[jt][i][j] += hout[i][j]; }
                }
            }

            kt++;
            // kt and jt read their start-of-cycle values, so both tests
            // compare against the last index rather than the count.
            if (layer == 1) {
                if (kt < 4) {
                    goto stage;
                } else {
                    kt = 0; jt++;
                    if (jt < 3) { goto stage; } else { goto epilogue1; }
                }
            } else {
                if (kt < 3) {
                    goto stage;
                } else {
                    kt = 0; jt++;
                    if (jt < 1) { goto stage; } else { goto epilogue2; }
                }
            }
        }

        // Layer 1 epilogue: bias, ReLU, requantise to uint8. acc1 is
        // rewritten in place and becomes the layer 2 activations.
        //
        // Reads inside a loop body see writes made earlier in the same body,
        // so these four steps chain within one cycle.
        epilogue1: {
            for (var int p = 0; p < 4; p++) {
                for (var int i = 0; i < 5; i++) {
                    for (var int j = 0; j < 5; j++) {
                        acc1[p][i][j] += b1t[p][j];
                        // SIGN 1: `< 0` would be an unsigned compare and
                        // never fire. Test the sign bit instead.
                        if ((acc1[p][i][j] >> 31) == 1) { acc1[p][i][j] = 0; }
                        // SIGN 2: >> is a logical shift. That is only correct
                        // because ReLU just guaranteed a non-negative value.
                        acc1[p][i][j] = acc1[p][i][j] >> 9;
                        if (acc1[p][i][j] > 255) { acc1[p][i][j] = 255; }
                    }
                }
            }
            layer = 2; kt = 0; jt = 0;
            goto stage;
        }

        // Layer 2 epilogue: bias, then offset every logit by 2^31.
        //
        // SIGN 3: flipping the sign bit maps int32 ordering onto uint32
        // ordering exactly, so the unsigned compares in `argmax` below rank
        // the logits the way a signed compare would.
        epilogue2: {
            for (var int p = 0; p < 2; p++) {
                for (var int i = 0; i < 5; i++) {
                    for (var int c = 0; c < 5; c++) {
                        acc2[p][i][c] = (acc2[p][i][c] + b2t[p][c]) + (1 << 31);
                    }
                }
            }
            goto argmax;
        }

        argmax: {
            for (var int i = 0; i < 5; i++) {
                best[i] = 0;
                pred[i] = 0;
                for (var int p = 0; p < 2; p++) {
                    for (var int c = 0; c < 5; c++) {
                        if (acc2[p][i][c] > best[i]) {
                            best[i] = acc2[p][i][c];
                            pred[i] = p * 5 + c;
                        }
                    }
                }
            }
            pp = 0; pc = 0; pi = 0;
            goto show_hidden;
        }

        // Reporting walks the results one per cycle with a runtime `goto`
        // loop -- prints issued in the same state share a clock edge and
        // Verilog leaves their order undefined.
        show_hidden: {
            print("h[", pp * 5 + pc, "] = ", acc1[pp][0][pc]);
            pc++;
            if (pc < 4) {
                goto show_hidden;
            } else {
                pc = 0; pp++;
                if (pp < 3) { goto show_hidden; } else { goto show_pred; }
            }
        }

        show_pred: {
            print("image ", pi, "  label ", lbl[pi], "  guess ", pred[pi]);
            pi++;
            if (pi < 4) { goto show_pred; } else { goto halt; }
        }

        halt: { goto halt; }
    }
}

instantiate {
    mlp = MnistMLP();
}
