        // Start a batch of 5 images. The array and the weights are shared
        // across all 20 batches; only the accumulators need clearing.
        batch: {
            for (var int p = 0; p < 8; p++) {
                for (var int i = 0; i < 5; i++) {
                    for (var int j = 0; j < 5; j++) { acc1[p][i][j] = 0; }
                }
            }
            for (var int p = 0; p < 2; p++) {
                for (var int i = 0; i < 5; i++) {
                    for (var int c = 0; c < 5; c++) { acc2[p][i][c] = 0; }
                }
            }
            layer = 1; kt = 0; jt = 0; pi = 0; cyc++;
