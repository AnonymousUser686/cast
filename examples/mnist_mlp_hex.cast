        }

        // Stage one 5x5 operand pair and clear the array. The very first
        // pair is placed directly on the hexagon's apex PE(4,4); every later
        // pair is injected by `step` on the cycle before it is needed.
        stage: {
            if (layer == 1) {
                for (var int i = 0; i < 5; i++) {
