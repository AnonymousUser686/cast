// 3x3 output-stationary systolic matmul, scalar registers only (old-compiler compatible).
//
// Notes for the compiler image on the ORBIT nodes:
//  - MAC is written c + (a_p * b_p): the parentheses are REQUIRED because that
//    compiler ignores operator precedence and would otherwise compute (c+a_p)*b_p.
//  - Each result line prints in its OWN state (one per cycle): multiple prints in
//    a single state fire on the same clock edge and come out in unspecified order.
machine SystolicMatmul3x3 {
    interface {}
    shared {
        var uint32 a_0_0; var uint32 a_0_1; var uint32 a_0_2;
        var uint32 a_1_0; var uint32 a_1_1; var uint32 a_1_2;
        var uint32 a_2_0; var uint32 a_2_1; var uint32 a_2_2;
        var uint32 b_0_0; var uint32 b_0_1; var uint32 b_0_2;
        var uint32 b_1_0; var uint32 b_1_1; var uint32 b_1_2;
        var uint32 b_2_0; var uint32 b_2_1; var uint32 b_2_2;
        var uint32 a_p_0_0; var uint32 a_p_0_1; var uint32 a_p_0_2;
        var uint32 a_p_1_0; var uint32 a_p_1_1; var uint32 a_p_1_2;
        var uint32 a_p_2_0; var uint32 a_p_2_1; var uint32 a_p_2_2;
        var uint32 b_p_0_0; var uint32 b_p_0_1; var uint32 b_p_0_2;
        var uint32 b_p_1_0; var uint32 b_p_1_1; var uint32 b_p_1_2;
        var uint32 b_p_2_0; var uint32 b_p_2_1; var uint32 b_p_2_2;
        var uint32 c_0_0; var uint32 c_0_1; var uint32 c_0_2;
        var uint32 c_1_0; var uint32 c_1_1; var uint32 c_1_2;
        var uint32 c_2_0; var uint32 c_2_1; var uint32 c_2_2;
        var uint32 t;
    }
    states {
        load: {
            a_0_0 = 1; a_0_1 = 2; a_0_2 = 3;
            a_1_0 = 4; a_1_1 = 5; a_1_2 = 6;
            a_2_0 = 7; a_2_1 = 8; a_2_2 = 9;
            b_0_0 = 1; b_0_1 = 2; b_0_2 = 3;
            b_1_0 = 2; b_1_1 = 4; b_1_2 = 6;
            b_2_0 = 3; b_2_1 = 6; b_2_2 = 9;
            print("[load] done");
            goto step;
        }
        step: {
            c_0_0 = c_0_0 + (a_p_0_0 * b_p_0_0); c_0_1 = c_0_1 + (a_p_0_1 * b_p_0_1); c_0_2 = c_0_2 + (a_p_0_2 * b_p_0_2);
            c_1_0 = c_1_0 + (a_p_1_0 * b_p_1_0); c_1_1 = c_1_1 + (a_p_1_1 * b_p_1_1); c_1_2 = c_1_2 + (a_p_1_2 * b_p_1_2);
            c_2_0 = c_2_0 + (a_p_2_0 * b_p_2_0); c_2_1 = c_2_1 + (a_p_2_1 * b_p_2_1); c_2_2 = c_2_2 + (a_p_2_2 * b_p_2_2);
            a_p_0_2 = a_p_0_1; a_p_0_1 = a_p_0_0;
            a_p_1_2 = a_p_1_1; a_p_1_1 = a_p_1_0;
            a_p_2_2 = a_p_2_1; a_p_2_1 = a_p_2_0;
            if (t == 0) { a_p_0_0 = a_0_0; } else if (t == 1) { a_p_0_0 = a_0_1; } else if (t == 2) { a_p_0_0 = a_0_2; } else { a_p_0_0 = 0; }
            if (t == 1) { a_p_1_0 = a_1_0; } else if (t == 2) { a_p_1_0 = a_1_1; } else if (t == 3) { a_p_1_0 = a_1_2; } else { a_p_1_0 = 0; }
            if (t == 2) { a_p_2_0 = a_2_0; } else if (t == 3) { a_p_2_0 = a_2_1; } else if (t == 4) { a_p_2_0 = a_2_2; } else { a_p_2_0 = 0; }
            b_p_2_0 = b_p_1_0; b_p_1_0 = b_p_0_0;
            b_p_2_1 = b_p_1_1; b_p_1_1 = b_p_0_1;
            b_p_2_2 = b_p_1_2; b_p_1_2 = b_p_0_2;
            if (t == 0) { b_p_0_0 = b_0_0; } else if (t == 1) { b_p_0_0 = b_1_0; } else if (t == 2) { b_p_0_0 = b_2_0; } else { b_p_0_0 = 0; }
            if (t == 1) { b_p_0_1 = b_0_1; } else if (t == 2) { b_p_0_1 = b_1_1; } else if (t == 3) { b_p_0_1 = b_2_1; } else { b_p_0_1 = 0; }
            if (t == 2) { b_p_0_2 = b_0_2; } else if (t == 3) { b_p_0_2 = b_1_2; } else if (t == 4) { b_p_0_2 = b_2_2; } else { b_p_0_2 = 0; }
            print("[step] t = ", t);
            t = t + 1;
            if (t < 7) { goto step; } else { goto done; }
        }
        done: {
            print("C = A * B:");
            goto row_0;
        }
        row_0: {
            print("  [ ", c_0_0, " ", c_0_1, " ", c_0_2, " ", "]");
            goto row_1;
        }
        row_1: {
            print("  [ ", c_1_0, " ", c_1_1, " ", c_1_2, " ", "]");
            goto row_2;
        }
        row_2: {
            print("  [ ", c_2_0, " ", c_2_1, " ", c_2_2, " ", "]");
            goto halt;
        }
        halt: { goto halt; }
    }
}

instantiate {
    sa = SystolicMatmul3x3();
}
