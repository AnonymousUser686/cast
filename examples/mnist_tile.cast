// One 5x5 tile of MNIST layer 1, run on the output-stationary systolic array.
//
// Generated by ml/gen_cast_tile.py from a quantised PyTorch MLP
// (10x10 pixels -> 20 hidden -> 10 classes,
//  92.80% integer test accuracy). Do not edit by hand.
//
//   C[i][j] = sum_k  X[i][k] * W[k][j]
//     X[i][k]  pixel 75+k of test image i     (uint8, 0..255)
//     W[k][j]  weight pixel 75+k -> hidden unit j  (int8, SIGNED)
//     C[i][j]  int32 partial accumulator
//
// Test image labels: [7, 2, 1, 0, 4]
//
// This is the signedness proof: W contains negative weights, so every printed
// value depends on negative multiplication being correct. Values are printed
// in sign-magnitude form because `print` formats wires as unsigned.

machine MnistTile {
    interface {}
    shared {
        var uint32 x[5][5];       // activations, always non-negative
        var uint32 w[5][5];       // weights, two's complement int8
        var uint32 a_pipe[5][5];
        var uint32 b_pipe[5][5];
        var uint32 c[5][5];
        var uint32 t;
    }
    states {
        load: {
            // image 0 (label 7), pixels 75..79
            x[0][0] = 133; x[0][1] = 13; x[0][2] = 0; x[0][3] = 0; x[0][4] = 0;
            // image 1 (label 2), pixels 75..79
            x[1][0] = 186; x[1][1] = 152; x[1][2] = 150; x[1][3] = 141; x[1][4] = 59;
            // image 2 (label 1), pixels 75..79
            x[2][0] = 11; x[2][1] = 0; x[2][2] = 0; x[2][3] = 0; x[2][4] = 0;
            // image 3 (label 0), pixels 75..79
            x[3][0] = 238; x[3][1] = 155; x[3][2] = 26; x[3][3] = 0; x[3][4] = 0;
            // image 4 (label 4), pixels 75..79
            x[4][0] = 43; x[4][1] = 161; x[4][2] = 3; x[4][3] = 0; x[4][4] = 0;

            // pixel 75 -> hidden units 0..4
            w[0][0] = 0 - 10; w[0][1] = 27; w[0][2] = 0 - 18; w[0][3] = 0 - 14; w[0][4] = 0 - 7;
            // pixel 76 -> hidden units 0..4
            w[1][0] = 0 - 11; w[1][1] = 2; w[1][2] = 0 - 36; w[1][3] = 15; w[1][4] = 14;
            // pixel 77 -> hidden units 0..4
            w[2][0] = 0 - 4; w[2][1] = 0 - 9; w[2][2] = 0 - 28; w[2][3] = 33; w[2][4] = 14;
            // pixel 78 -> hidden units 0..4
            w[3][0] = 12; w[3][1] = 0 - 6; w[3][2] = 0 - 22; w[3][3] = 25; w[3][4] = 2;
            // pixel 79 -> hidden units 0..4
            w[4][0] = 34; w[4][1] = 0 - 43; w[4][2] = 0 - 27; w[4][3] = 69; w[4][4] = 33;

            print("MnistTile: 5x5 layer-1 tile, signed weights");
            goto step;
        }

        step: {
            // MAC: every PE accumulates the operand pair it holds.
            for (var int i = 0; i < 5; i++) {
                for (var int j = 0; j < 5; j++) {
                    c[i][j] += a_pipe[i][j] * b_pipe[i][j];
                }
            }

            // Activations flow left -> right, row i skewed by i cycles.
            for (var int i = 0; i < 5; i++) {
                for (var int j = 4; j > 0; j--) {
                    a_pipe[i][j] = a_pipe[i][j - 1];
                }
                if (t >= i && t < i + 5) {
                    a_pipe[i][0] = x[i][t - i];
                } else {
                    a_pipe[i][0] = 0;
                }
            }

            // Weights flow top -> bottom, column j skewed by j cycles.
            for (var int j = 0; j < 5; j++) {
                for (var int i = 4; i > 0; i--) {
                    b_pipe[i][j] = b_pipe[i - 1][j];
                }
                if (t >= j && t < j + 5) {
                    b_pipe[0][j] = w[t - j][j];
                } else {
                    b_pipe[0][j] = 0;
                }
            }

            t++;
            // t reads its start-of-cycle value here, so the MAC at t == 13
            // still runs before we leave.
            if (t < 13) {
                goto step;
            } else {
                goto done;
            }
        }

        done: {
            print("C = X * W:");
            goto e_0_0;
        }

        e_0_0: {
            if (c[0][0] >= 2147483648) {
                print("  C[0][0] = -", 0 - c[0][0]);
            } else {
                print("  C[0][0] = ", c[0][0]);
            }
            goto e_0_1;
        }
        e_0_1: {
            if (c[0][1] >= 2147483648) {
                print("  C[0][1] = -", 0 - c[0][1]);
            } else {
                print("  C[0][1] = ", c[0][1]);
            }
            goto e_0_2;
        }
        e_0_2: {
            if (c[0][2] >= 2147483648) {
                print("  C[0][2] = -", 0 - c[0][2]);
            } else {
                print("  C[0][2] = ", c[0][2]);
            }
            goto e_0_3;
        }
        e_0_3: {
            if (c[0][3] >= 2147483648) {
                print("  C[0][3] = -", 0 - c[0][3]);
            } else {
                print("  C[0][3] = ", c[0][3]);
            }
            goto e_0_4;
        }
        e_0_4: {
            if (c[0][4] >= 2147483648) {
                print("  C[0][4] = -", 0 - c[0][4]);
            } else {
                print("  C[0][4] = ", c[0][4]);
            }
            goto e_1_0;
        }
        e_1_0: {
            if (c[1][0] >= 2147483648) {
                print("  C[1][0] = -", 0 - c[1][0]);
            } else {
                print("  C[1][0] = ", c[1][0]);
            }
            goto e_1_1;
        }
        e_1_1: {
            if (c[1][1] >= 2147483648) {
                print("  C[1][1] = -", 0 - c[1][1]);
            } else {
                print("  C[1][1] = ", c[1][1]);
            }
            goto e_1_2;
        }
        e_1_2: {
            if (c[1][2] >= 2147483648) {
                print("  C[1][2] = -", 0 - c[1][2]);
            } else {
                print("  C[1][2] = ", c[1][2]);
            }
            goto e_1_3;
        }
        e_1_3: {
            if (c[1][3] >= 2147483648) {
                print("  C[1][3] = -", 0 - c[1][3]);
            } else {
                print("  C[1][3] = ", c[1][3]);
            }
            goto e_1_4;
        }
        e_1_4: {
            if (c[1][4] >= 2147483648) {
                print("  C[1][4] = -", 0 - c[1][4]);
            } else {
                print("  C[1][4] = ", c[1][4]);
            }
            goto e_2_0;
        }
        e_2_0: {
            if (c[2][0] >= 2147483648) {
                print("  C[2][0] = -", 0 - c[2][0]);
            } else {
                print("  C[2][0] = ", c[2][0]);
            }
            goto e_2_1;
        }
        e_2_1: {
            if (c[2][1] >= 2147483648) {
                print("  C[2][1] = -", 0 - c[2][1]);
            } else {
                print("  C[2][1] = ", c[2][1]);
            }
            goto e_2_2;
        }
        e_2_2: {
            if (c[2][2] >= 2147483648) {
                print("  C[2][2] = -", 0 - c[2][2]);
            } else {
                print("  C[2][2] = ", c[2][2]);
            }
            goto e_2_3;
        }
        e_2_3: {
            if (c[2][3] >= 2147483648) {
                print("  C[2][3] = -", 0 - c[2][3]);
            } else {
                print("  C[2][3] = ", c[2][3]);
            }
            goto e_2_4;
        }
        e_2_4: {
            if (c[2][4] >= 2147483648) {
                print("  C[2][4] = -", 0 - c[2][4]);
            } else {
                print("  C[2][4] = ", c[2][4]);
            }
            goto e_3_0;
        }
        e_3_0: {
            if (c[3][0] >= 2147483648) {
                print("  C[3][0] = -", 0 - c[3][0]);
            } else {
                print("  C[3][0] = ", c[3][0]);
            }
            goto e_3_1;
        }
        e_3_1: {
            if (c[3][1] >= 2147483648) {
                print("  C[3][1] = -", 0 - c[3][1]);
            } else {
                print("  C[3][1] = ", c[3][1]);
            }
            goto e_3_2;
        }
        e_3_2: {
            if (c[3][2] >= 2147483648) {
                print("  C[3][2] = -", 0 - c[3][2]);
            } else {
                print("  C[3][2] = ", c[3][2]);
            }
            goto e_3_3;
        }
        e_3_3: {
            if (c[3][3] >= 2147483648) {
                print("  C[3][3] = -", 0 - c[3][3]);
            } else {
                print("  C[3][3] = ", c[3][3]);
            }
            goto e_3_4;
        }
        e_3_4: {
            if (c[3][4] >= 2147483648) {
                print("  C[3][4] = -", 0 - c[3][4]);
            } else {
                print("  C[3][4] = ", c[3][4]);
            }
            goto e_4_0;
        }
        e_4_0: {
            if (c[4][0] >= 2147483648) {
                print("  C[4][0] = -", 0 - c[4][0]);
            } else {
                print("  C[4][0] = ", c[4][0]);
            }
            goto e_4_1;
        }
        e_4_1: {
            if (c[4][1] >= 2147483648) {
                print("  C[4][1] = -", 0 - c[4][1]);
            } else {
                print("  C[4][1] = ", c[4][1]);
            }
            goto e_4_2;
        }
        e_4_2: {
            if (c[4][2] >= 2147483648) {
                print("  C[4][2] = -", 0 - c[4][2]);
            } else {
                print("  C[4][2] = ", c[4][2]);
            }
            goto e_4_3;
        }
        e_4_3: {
            if (c[4][3] >= 2147483648) {
                print("  C[4][3] = -", 0 - c[4][3]);
            } else {
                print("  C[4][3] = ", c[4][3]);
            }
            goto e_4_4;
        }
        e_4_4: {
            if (c[4][4] >= 2147483648) {
                print("  C[4][4] = -", 0 - c[4][4]);
            } else {
                print("  C[4][4] = ", c[4][4]);
            }
            goto halt;
        }

        halt: {
            goto halt;
        }
    }
}

instantiate {
    tile = MnistTile();
}

