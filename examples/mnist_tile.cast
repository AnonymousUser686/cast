            } else {
                print("  C[1][0] = ", c[1][0]);
            }
            goto e_1_1;
        }
        e_1_1: {
            // `< 0` is an unsigned compare and would never fire, so test the
            // sign bit. >> is logical, which is exactly what is wanted here.
            if ((c[1][1] >> 31) == 1) {
                print("  C[1][1] = -", 0 - c[1][1]);
            } else {
                print("  C[1][1] = ", c[1][1]);
            }
            goto e_1_2;
        }
        e_1_2: {
            // `< 0` is an unsigned compare and would never fire, so test the
            // sign bit. >> is logical, which is exactly what is wanted here.
            if ((c[1][2] >> 31) == 1) {
                print("  C[1][2] = -", 0 - c[1][2]);
            } else {
                print("  C[1][2] = ", c[1][2]);
            }
            goto e_1_3;
        }
        e_1_3: {
            // `< 0` is an unsigned compare and would never fire, so test the
            // sign bit. >> is logical, which is exactly what is wanted here.
            if ((c[1][3] >> 31) == 1) {
                print("  C[1][3] = -", 0 - c[1][3]);
            } else {
                print("  C[1][3] = ", c[1][3]);
            }
            goto e_1_4;
        }
        e_1_4: {
            // `< 0` is an unsigned compare and would never fire, so test the
            // sign bit. >> is logical, which is exactly what is wanted here.
            if ((c[1][4] >> 31) == 1) {
                print("  C[1][4] = -", 0 - c[1][4]);
            } else {
                print("  C[1][4] = ", c[1][4]);
            }
            goto e_2_0;
        }
        e_2_0: {
            // `< 0` is an unsigned compare and would never fire, so test the
