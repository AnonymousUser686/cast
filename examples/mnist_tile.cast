            if ((c[2][3] >> 31) == 1) {
                print("  C[2][3] = -", 0 - c[2][3]);
            } else {
                print("  C[2][3] = ", c[2][3]);
            }
            goto e_2_4;
        }
        e_2_4: {
            // `< 0` is an unsigned compare and would never fire, so test the
