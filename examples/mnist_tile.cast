// One 5x5 tile of MNIST layer 1, run on the output-stationary systolic array.
//
// Generated by ml/gen_cast_tile.py from a quantised PyTorch MLP
// (10x10 pixels -> 40 hidden -> 10 classes,
//  95.97% integer test accuracy). Do not edit by hand.
//
//   C[i][j] = sum_k  X[i][k] * W[k][j]
//     X[i][k]  pixel 25+k of test image i     (uint8, 0..255)
//     W[k][j]  weight pixel 25+k -> hidden unit j  (int8, SIGNED)
//     C[i][j]  int32 partial accumulator
//
// Test image labels: [7, 2, 1, 0, 4]
//
// This is the signedness proof: W contains negative weights, so every printed
// value depends on negative multiplication being correct. Values are printed
// in sign-magnitude form because `print` formats wires as unsigned.

machine MnistTile {
    interface {}
    shared {
        var uint32 x[5][5];       // activations, always non-negative
        var uint32 w[5][5];       // weights, two's complement int8
        var uint32 a_pipe[5][5];
        var uint32 b_pipe[5][5];
        var uint32 c[5][5];
        var uint32 t;
    }
    states {
        load: {
            // image 0 (label 7), pixels 25..29
            x[0][0] = 226; x[0][1] = 225; x[0][2] = 220; x[0][3] = 154; x[0][4] = 0;
            // image 1 (label 2), pixels 25..29
            x[1][0] = 241; x[1][1] = 132; x[1][2] = 0; x[1][3] = 0; x[1][4] = 0;
            // image 2 (label 1), pixels 25..29
            x[2][0] = 72; x[2][1] = 138; x[2][2] = 0; x[2][3] = 0; x[2][4] = 0;
            // image 3 (label 0), pixels 25..29
            x[3][0] = 248; x[3][1] = 244; x[3][2] = 194; x[3][3] = 0; x[3][4] = 0;
            // image 4 (label 4), pixels 25..29
            x[4][0] = 0; x[4][1] = 0; x[4][2] = 76; x[4][3] = 136; x[4][4] = 0;

            // pixel 25 -> hidden units 0..4
            w[0][0] = 0 - 43; w[0][1] = 37; w[0][2] = 1; w[0][3] = 33; w[0][4] = 14;
            // pixel 26 -> hidden units 0..4
            w[1][0] = 0 - 8; w[1][1] = 19; w[1][2] = 22; w[1][3] = 10; w[1][4] = 0 - 11;
            // pixel 27 -> hidden units 0..4
            w[2][0] = 0 - 17; w[2][1] = 8; w[2][2] = 25; w[2][3] = 0 - 3; w[2][4] = 0 - 23;
            // pixel 28 -> hidden units 0..4
            w[3][0] = 0 - 19; w[3][1] = 11; w[3][2] = 7; w[3][3] = 3; w[3][4] = 0 - 20;
            // pixel 29 -> hidden units 0..4
            w[4][0] = 0 - 9; w[4][1] = 14; w[4][2] = 44; w[4][3] = 29; w[4][4] = 6;

            print("MnistTile: 5x5 layer-1 tile, signed weights");
            goto step;
        }

        step: {
            // MAC: every PE accumulates the operand pair it holds.
            for (var int i = 0; i < 5; i++) {
                for (var int j = 0; j < 5; j++) {
                    c[i][j] += a_pipe[i][j] * b_pipe[i][j];
                }
            }

            // Activations flow left -> right, row i skewed by i cycles.
            for (var int i = 0; i < 5; i++) {
                for (var int j = 4; j > 0; j--) {
                    a_pipe[i][j] = a_pipe[i][j - 1];
                }
                if (t >= i && t < i + 5) {
                    a_pipe[i][0] = x[i][t - i];
                } else {
                    a_pipe[i][0] = 0;
                }
            }

            // Weights flow top -> bottom, column j skewed by j cycles.
            for (var int j = 0; j < 5; j++) {
                for (var int i = 4; i > 0; i--) {
                    b_pipe[i][j] = b_pipe[i - 1][j];
                }
                if (t >= j && t < j + 5) {
                    b_pipe[0][j] = w[t - j][j];
                } else {
                    b_pipe[0][j] = 0;
                }
            }

            t++;
            // t reads its start-of-cycle value here, so the MAC at t == 13
            // still runs before we leave.
            if (t < 13) {
                goto step;
            } else {
                goto done;
            }
        }

        done: {
            print("C = X * W:");
            goto e_0_0;
        }

        e_0_0: {
            // `< 0` is an unsigned compare and would never fire, so test the
            // sign bit. >> is logical, which is exactly what is wanted here.
            if ((c[0][0] >> 31) == 1) {
                print("  C[0][0] = -", 0 - c[0][0]);
            } else {
                print("  C[0][0] = ", c[0][0]);
            }
            goto e_0_1;
        }
        e_0_1: {
            // `< 0` is an unsigned compare and would never fire, so test the
            // sign bit. >> is logical, which is exactly what is wanted here.
            if ((c[0][1] >> 31) == 1) {
                print("  C[0][1] = -", 0 - c[0][1]);
            } else {
                print("  C[0][1] = ", c[0][1]);
            }
            goto e_0_2;
        }
        e_0_2: {
            // `< 0` is an unsigned compare and would never fire, so test the
            // sign bit. >> is logical, which is exactly what is wanted here.
            if ((c[0][2] >> 31) == 1) {
                print("  C[0][2] = -", 0 - c[0][2]);
            } else {
                print("  C[0][2] = ", c[0][2]);
            }
            goto e_0_3;
        }
        e_0_3: {
            // `< 0` is an unsigned compare and would never fire, so test the
            // sign bit. >> is logical, which is exactly what is wanted here.
            if ((c[0][3] >> 31) == 1) {
                print("  C[0][3] = -", 0 - c[0][3]);
            } else {
                print("  C[0][3] = ", c[0][3]);
            }
            goto e_0_4;
        }
        e_0_4: {
            // `< 0` is an unsigned compare and would never fire, so test the
            // sign bit. >> is logical, which is exactly what is wanted here.
            if ((c[0][4] >> 31) == 1) {
                print("  C[0][4] = -", 0 - c[0][4]);
            } else {
                print("  C[0][4] = ", c[0][4]);
            }
            goto e_1_0;
        }
        e_1_0: {
            // `< 0` is an unsigned compare and would never fire, so test the
            // sign bit. >> is logical, which is exactly what is wanted here.
            if ((c[1][0] >> 31) == 1) {
